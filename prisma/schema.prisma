generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum FacebookPostStatus {
  NOT_REQUESTED
  PENDING
  POSTED
  FAILED
  REMOVED
}

// Articles received from GrandRanker via /api/articles-webhook.
model Article {
  externalId             String             @id @map("external_id")
  title                  String?
  slug                   String?            @unique
  contentHtml            String?            @map("content_html")
  contentMarkdown        String?            @map("content_markdown")
  metaTitle              String?            @map("meta_title")
  metaDescription        String?            @map("meta_description")
  subtitle               String?
  category               String?
  authorName             String?            @map("author_name")
  imageUrl               String?            @map("image_url")
  readTime               String?            @map("read_time")
  wordCount              Int?               @map("word_count")
  tags                   Json?
  faqs                   Json?
  jsonLdSchema           Json?               @map("json_ld_schema")
  languageCode           String?             @map("language_code")
  publishedAt            DateTime?           @map("published_at")
  updatedAt              DateTime            @default(now()) @map("updated_at")
  facebookBlurb          String?             @map("facebook_blurb")
  facebookPostingEnabled Boolean             @default(false) @map("facebook_posting_enabled")
  facebookPostStatus     FacebookPostStatus  @default(NOT_REQUESTED) @map("facebook_post_status")
  facebookPostId         String?             @map("facebook_post_id")
  facebookPostUrl        String?             @map("facebook_post_url")
  facebookPostedAt       DateTime?           @map("facebook_posted_at")
  facebookLastAttemptAt  DateTime?           @map("facebook_last_attempt_at")
  facebookAttemptCount   Int                 @default(0) @map("facebook_attempt_count")
  facebookPostError      String?             @map("facebook_post_error")

  @@index([publishedAt])
  @@index([facebookPostStatus, publishedAt])
  @@map("articles")
}

model PreparedArticlePackage {
  id          String   @id @default(cuid())
  planSlug    String   @unique @map("plan_slug")
  title       String
  packageJson Json     @map("package_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("prepared_article_packages")
}
